# Dependencies
node_modules/

# Build outputs that are NOT committed.
# Note: assets/css/style.css, assets/icons/sprite.svg and the generated tally field
# in index.html ARE committed on purpose, so GitHub Pages needs no build step.

# Editor
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Temporary and backup
*.tmp
*.temp
*.bak
*.old
*.log
.cache/

# Playwright artefacts
test-results/
playwright-report/
playwright/.cache/

# Environment
.env
.env.local
.env.*.local

# The walkthrough recording is 35 MB. Excluded until it is compressed; nothing on
# the site links to it, so there are no broken references.
assets/videos/
